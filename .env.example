# For usage with Anthropic (-l claude, which is default)
# Change ANTHROPIC_API_KEY to proper credentials or export it as an environment variable
# > export ANTHROPIC_API_KEY=sk-1234

#ANTHROPIC_API_KEY=sk-1234
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-5


# For usage with OpenAI (-l gpt)
# Change OPENAI_API_KEY to proper credentials or export it as an environment variable
# > export OPENAI_API_KEY=sk-1234

#OPENAI_API_KEY=sk-1234
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=chatgpt-4o-latest


# For usage with Ollama (-l ollama)
# Change the OLLAMA_MODEL to the desired model and OLLAMA_BASE_URL to the proper endpoint

OLLAMA_BASE_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3.2


# For usage with OpenRouter (-l openrouter)
# Change OPENROUTER_API_KEY to proper credentials or export it as an environment variable
# > export OPENROUTER_API_KEY=sk-or-v1-...
# Free models don't require an API key

#OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=qwen/qwen3-coder:free


# ── CLI Providers (--llm claude-code / gemini-cli / codex / qwen-code) ───────
#
# CLI providers delegate to an external binary and handle their own auth.
# Vulnhuntr strips its own API key env vars from the subprocess environment
# automatically, so the binary uses its own stored credentials.
#
# claude-code: authenticate with `claude login` once.
#   Vulnhuntr strips ANTHROPIC_API_KEY from the subprocess env.
#   No env vars required here.
#
# gemini-cli: authenticate with `gemini login` once.
#   Vulnhuntr strips GOOGLE_API_KEY and GEMINI_API_KEY from the subprocess env.
#   No env vars required here.
#
# codex: uses OPENAI_API_KEY directly (binary does not have its own stored auth).
#   Set the key below or export it; Vulnhuntr does NOT strip it automatically.
#OPENAI_API_KEY=sk-1234
#
# qwen-code: uses DASHSCOPE_API_KEY directly, or `qwen login` stored credentials.
#   Set the key below if not using stored auth.
#DASHSCOPE_API_KEY=sk-1234